nextflow_process {

    name "Test Process BEAGLE_SUBSET"
    script "../main.nf"
    process "BEAGLE_SUBSET"

    tag "modules"
    tag "modules_local"
    tag "beagle"
    tag "beagle/subset"

    test("beagle - subset two of four samples") {

        when {
            process {
                """
                input[0] = [
                    [ id: "FIN_subset", samples: ["HG00350", "HG00349"] ],
                    file(params.modules_testdata_base_path + 'delete_me/pcangsd/FIN.beagle.gz', checkIfExists: true),
                    [ "HG00349", "HG00358", "HG00350", "HG00351" ],
                    [ "HG00350", "HG00349" ]
                ]
                """
            }
        }

        then {
            assert process.success
            def lines = path(process.out.beagle[0][1]).linesGzip
            def first = lines[1].split('\t')
            assertAll(
                { assert snapshot(process.out).match() },
                // marker, allele1, allele2 + 3 likelihoods for each of 2 samples
                { assert lines[0].split('\t') == ['marker', 'allele1', 'allele2', 'Ind0', 'Ind0', 'Ind0', 'Ind1', 'Ind1', 'Ind1'] },
                { assert lines.every { line -> line.split('\t').size() == 9 } },
                { assert first.size() == 9 },
                { assert path(process.out.samples[0][1]).readLines() == ['HG00350', 'HG00349'] }
            )
        }

    }

    test("beagle - subset - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: "FIN_subset", samples: ["HG00350", "HG00349"] ],
                    file(params.modules_testdata_base_path + 'delete_me/pcangsd/FIN.beagle.gz', checkIfExists: true),
                    [ "HG00349", "HG00358", "HG00350", "HG00351" ],
                    [ "HG00350", "HG00349" ]
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
