nextflow_process {

    name "Test Process PCANGSD_PCA"
    script "../main.nf"
    process "PCANGSD_PCA"

    tag "modules"
    tag "modules_local"
    tag "pcangsd"
    tag "pcangsd/pca"

    test("pcangsd - beagle") {

        when {
            process {
                """
                input[0] = [
                    [ id: "FIN", samples: ["HG00349", "HG00358", "HG00350", "HG00351"] ],
                    [ file(params.modules_testdata_base_path + 'delete_me/pcangsd/FIN.beagle.gz', checkIfExists: true) ]
                ]
                """
            }
        }

        then {
            assert process.success
            // Covariance values vary slightly between runs (multithreaded/randomised SVD), so check shape not md5
            def cov = path(process.out.covariance[0][1]).readLines()
            assertAll(
                { assert snapshot(
                    process.out.covariance.collect { meta, f -> [ meta, file(f).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() },
                { assert cov.size() == 4 },
                { assert cov.every { row -> row.trim().split(/\s+/).size() == 4 } },
                { assert path(process.out.log[0][1]).text.contains('Saved covariance matrix') }
            )
        }

    }

    test("pcangsd - beagle - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: "FIN", samples: ["HG00349", "HG00358", "HG00350", "HG00351"] ],
                    [ file(params.modules_testdata_base_path + 'delete_me/pcangsd/FIN.beagle.gz', checkIfExists: true) ]
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
